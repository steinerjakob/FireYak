require 'tmpdir'
require 'fileutils'

# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

def get_package_version_without_prerelease
  # Load package.json
  package = load_json(json_path: "./package.json")

  # Get version and strip prerelease information
  version = package["version"]

  # Remove prerelease information (everything after the first hyphen)
  # This handles cases like "1.2.3-beta.1" -> "1.2.3"
  clean_version = version.split('-')[0]

  return clean_version
end

platform :android do
  desc "Upload a pre-built, signed AAB to the Play Store internal testing track"
  lane :internal do |options|
    upload_to_play_store(
      track: "internal",
      aab: options[:aab],
      skip_upload_apk: true,
      skip_upload_screenshots: true,
      skip_upload_images: true
    )
  end

  desc "Publish a pre-built, signed AAB of a tagged release straight to production"
  lane :production do |options|
    upload_to_play_store(
      track: "production",
      release_status: "completed",
      aab: options[:aab],
      skip_upload_apk: true,
      skip_upload_screenshots: true,
      skip_upload_images: true
    )
  end
end

platform :ios do

  private_lane :default_ios_app_build do |options|
    setup_ci
    ios_dir = File.expand_path('../ios')

    # `version` overrides the marketing version (main-branch dev builds ship
    # the upcoming release's version; see .github/workflows/dev-builds.yml).
    increment_version_number(
      version_number: options[:version] || get_package_version_without_prerelease,
      xcodeproj: File.join(ios_dir, "App/App.xcodeproj")
    )

    match(type: "appstore", readonly: is_ci, api_key_path: "./authkey.json")

    # `build_number` sets CFBundleVersion (Info.plist reads CURRENT_PROJECT_VERSION).
    # It must grow across dev and release uploads of the same version.
    xcargs = options[:build_number] ? "CURRENT_PROJECT_VERSION=#{options[:build_number]}" : nil
    # CI pre-resolves Swift packages with retries into SPM_PACKAGES_DIR (ios.yml).
		build_app(
      project: File.join(ios_dir, "App/App.xcodeproj"),
      scheme: "App",
      xcargs: xcargs,
      cloned_source_packages_path: ENV["SPM_PACKAGES_DIR"]
    )

  end

  lane :beta do |options|
    desc "Push a new build to TestFlight"
    default_ios_app_build(options)
		pilot(
				skip_waiting_for_build_processing: true,
				distribute_external: false,
        api_key_path: "./authkey.json"
		)
  end

  desc "Build a tagged release, upload it and submit it for App Store review (auto-release on approval)"
  lane :release do |options|
    default_ios_app_build(options)
    # Wait for processing: a build can only be submitted once App Store Connect has processed it.
    pilot(
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      api_key_path: "./authkey.json"
    )

    # Only the release notes are sent with the submission; the rest of the store
    # listing (description, keywords, screenshots) is left as it is in App Store Connect.
    notes_dir = File.join(Dir.mktmpdir, "metadata")
    Dir.glob(File.expand_path("metadata/ios/*/release_notes.txt", __dir__)).each do |file|
      locale_dir = File.join(notes_dir, File.basename(File.dirname(file)))
      FileUtils.mkdir_p(locale_dir)
      FileUtils.cp(file, locale_dir)
    end

    deliver(
      api_key_path: "./authkey.json",
      app_version: lane_context[SharedValues::VERSION_NUMBER] || get_package_version_without_prerelease,
      build_number: options[:build_number].to_s,
      skip_binary_upload: true,
      skip_screenshots: true,
      metadata_path: notes_dir,
      submit_for_review: true,
      automatic_release: true,
      force: true, # no interactive HTML preview on CI
      run_precheck_before_submit: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
  end

end
